# 复制本文件为 .env 后填写。.env 已被 .gitignore 排除，不会进版本库。

# 阿里云百炼 API Key，控制台 https://bailian.console.aliyun.com 获取
DASHSCOPE_API_KEY=

# 可选：换模型对比效果。qwen-vl-max 精度优先，qwen-vl-plus 更便宜
MODEL=qwen-vl-max

# 单据无年份时按此年份补全，填样本所属年份
FALLBACK_YEAR=2026

# 低于此置信度的字段标黄要求复核。实测静默出错偏多就往上调
CONFIDENCE_THRESHOLD=0.75

MAX_WORKERS=4
